# Copie para .env e ajuste.  (o .env real é ignorado pelo git)

# --- MQTT: dev local (Mosquitto do docker-compose) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# --- MQTT: produção com o firmware real (HiveMQ Cloud) — descomente e ajuste ---
# MQTT_URL=mqtts://SEU-CLUSTER.s1.eu.hivemq.cloud:8883
# MQTT_TLS=true
# MQTT_USERNAME=esp32-satsmeter
# MQTT_PASSWORD=sua-senha

# Contrato de tópicos (igual ao firmware) e id padrão quando a leitura não traz casaId:
TOPIC_LEITURAS=satsmeter/leituras
TOPIC_COMANDOS=satsmeter/comandos
TOPIC_RECARGA=satsmeter/recarga
DEVICE_ID=device-01

# --- Regras de negócio ---
SATS_POR_MWH=0.5          # tarifa (sats por mWh consumido)
CARENCIA_LEITURAS=3       # leituras sem saldo antes do corte
SALDO_MINIMO_RELIGA=50    # sats mínimos para religar (anti-flapping)
SALDO_INICIAL=6000        # saldo pré-pago inicial por casa (sats)
WH_POR_LIQ=1              # energia por microliquidação (Wh) -> 1 evento no extrato

# --- HTTP ---
PORT=8000

# --- Lightning (LNbits) — deixe LNBITS_URL vazio para modo simulado ---
LNBITS_URL=
LNBITS_INVOICE_KEY=

# --- Persistência ---
LEDGER_FILE=ledger.json
