// SatsMeter — configuração do dispositivo.
// Copie para config.h e ajuste (config.h é ignorado pelo git).
//
//   cp src/config.h.example src/config.h

#pragma once

// --- Wi-Fi ---
#define WIFI_SSID   "SUA_REDE"
#define WIFI_PASS   "SUA_SENHA"

// --- Broker MQTT (IP da máquina que roda o docker/backend) ---
#define MQTT_HOST   "192.168.0.100"
#define MQTT_PORT   1883

// --- Identidade da casa (aparece no extrato como #A-042) ---
#define CASA_ID     "A-042"

// --- Rede elétrica (para P = V * I quando o sensor mede só corrente) ---
// O INA219 já mede tensão e corrente direto; VREDE fica de reserva.
#define VREDE       127.0
